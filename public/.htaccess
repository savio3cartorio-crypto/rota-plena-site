# Rota Plena - site estático (Hostinger)
# Bloqueia acesso aos metadados do Git
RedirectMatch 404 /\.git
Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
# Endereços antigos (reestruturação de 25/10/2026)
RewriteRule ^noticias(/.*)?$ /diario/ [R=301,L]
RewriteRule ^comunidade/?$ /sobre/#historia [R=301,NE,L]
RewriteRule ^depoimentos/?$ /sobre/#historia [R=301,NE,L]
RewriteRule ^aprenda/?$ /comecar/#guias [R=301,NE,L]
RewriteRule ^blog/?$ /comecar/#guias [R=301,NE,L]
RewriteRule ^autor/?$ /diario/ [R=301,L]
RewriteRule ^diarios/?$ /diario/ [R=301,L]
RewriteRule ^guia-do-mapa/?$ /mapa/ [R=301,L]
RewriteRule ^(membros|admin|paginas)(/.*)?$ / [R=301,L]
# Roteiros ainda não percorridos voltam para a lista (302: podem voltar ao ar depois)
RewriteCond %{DOCUMENT_ROOT}/rotas/$1 !-d
RewriteRule ^rotas/([^/]+)/?$ /rotas/ [R=302,L]
ErrorDocument 404 /404.html
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/csv application/javascript application/json application/xml image/svg+xml
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
